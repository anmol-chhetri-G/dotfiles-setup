{
    "layer": "top",
    "position": "top",
    "margin-top": 7,
    "width": "auto",
    "modules-left": [
        "custom/arch_logo",
        "hyprland/workspaces"
        // "custom/active_window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "backlight",
        "network",
        "pulseaudio",
        "battery",
        "custom/power"
    ],
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "clock": {
        "format": "{:%a, %d %b  %I:%M %p}",
        "format-alt": "{:%a, %d. %b  %H:%M %p}"

    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "",
            // this down is your wired earphone/headphone (headset)
            "headset": "󰋎",
            "phone": "",
            "phone-muted": "󰟎",
            "portable": "",
            "car": "",
            "default": [
                "",
                "󰋋"
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "network": {
        "interface": [
            "enp68s0",
            "wlp0s20f3",
	    "tun0"
        ],
        // Show only WiFi or Ethernet (Waybar auto-detects)
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": " {ipaddr}/{cidr}",
        // If no connection
        "format-disconnected": "󱚼",
        // Tooltips
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        //  "on-click": "nmtui",
        "max-length": 50
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5, // 5 workspaces by default on every monitor
            "HDMI-A-1": 3 // but only three on HDMI-A-1
        }
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% {icon}",
        "format-icons": [
            "󰃜",
            "󰃝",
            "󰃟",
            "󰃠"
        ]
    },
    "custom/arch_logo": {
        "format": "󰣇",
        "on-click": "rofi -show drun", // or "rofi -show drun", or "hyprctl dispatch exec $terminal"
        "tooltip": "Launch Menu"
    },
    "custom/power": {
        "format": "", // or "⏻", "", etc.
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip": "Power menu"
    }
}
